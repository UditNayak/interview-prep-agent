# ── Copy this file to ".env" and fill in your own keys ──
#    cp .env.example .env

# Gemini (Google AI Studio) — https://aistudio.google.com/apikey
# Free tier covers gemini-2.5-flash. (2.0-flash was retired on 2026-06-01.)
GEMINI_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Tavily — https://app.tavily.com   (web search; 1,000 free credits/month)
TAVILY_API_KEY=

# The "From" address on the emailed report. Use the same email as your
# SMTP credential below (for Gmail, this is your Gmail address).
FROM_EMAIL=

# Any long random string. Generate one with:  openssl rand -hex 24
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
